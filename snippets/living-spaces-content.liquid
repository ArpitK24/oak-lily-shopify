{% comment %}
  Oak & Lily Living Spaces Collection Content
  Faithful replica using Shopify live products, Shopify CDN media, and authentic layout
{% endcomment %}

{{ 'section-collection.css' | asset_url | stylesheet_tag }}

{%- assign col_key = active_collection | default: collection.handle | default: 'living-space' -%}

<div class="custom-banner-wrapper">
  <div class="custom-banner">
    <a href="/bundle">
      <picture>
        <img src="{{ 'kitchen-bundle-banner.png' | asset_url }}" alt="Promotional banner" loading="lazy">
      </picture>
    </a>
  </div>
</div>

<div class="collection-hero">
  <div class="collection-hero__inner">
    <h1 class="collection-hero__title" id="living-collection-title-display">
      {% case col_key %}
        {% when 'throw' %}Throw
        {% when 'beach-towels' %}Beach Towels
        {% when 'cushion-covers' %}CUSHION COVERS
        {% else %}LIVING SPACE
      {% endcase %}
    </h1>
  </div>
</div>

<div class="collection-page">
  <div id="living-collection-grids-wrapper">
    <div class="collection-grid-container" id="grid-container-living-space" style="display: none;">
      <ul id="product-grid-living-space" class="collection-product-grid collection-grid-box" data-collection="living-space">
        {% render 'living-cards-space' %}
      </ul>
    </div>
    {% render 'living-cards-sub' %}
  </div>
</div>

<script>
  (function() {
    var p = window.location.pathname.toLowerCase();
    var isLiving = p.indexOf('/living-space') !== -1 || p.indexOf('/throw') !== -1 || p.indexOf('/beach-towels') !== -1 || p.indexOf('/cushion-covers') !== -1;
    if (!isLiving) return;

    var activeKey = 'living-space';
    
    if (p.indexOf('/throw') !== -1) activeKey = 'throw';
    else if (p.indexOf('/beach-towels') !== -1) activeKey = 'beach-towels';
    else if (p.indexOf('/cushion-covers') !== -1) activeKey = 'cushion-covers';
    else if (p.indexOf('/living-space') !== -1) activeKey = 'living-space';

    var titles = {
      'throw': 'Throw',
      'beach-towels': 'Beach Towels',
      'cushion-covers': 'CUSHION COVERS',
      'living-space': 'LIVING SPACE'
    };

    var titleEl = document.getElementById('living-collection-title-display');
    if (titleEl && titles[activeKey]) {
      titleEl.textContent = titles[activeKey];
      document.title = titles[activeKey] + ' – OAK AND LILY';
    }

    var targetGrid = document.getElementById('grid-container-' + activeKey);
    if (!targetGrid) targetGrid = document.getElementById('grid-container-living-space');
    if (targetGrid) targetGrid.style.display = 'block';

    // Highlight LIVING SPACES in header
    var headerLiving = document.querySelector('#Details-HeaderMenu-6 summary');
    if (headerLiving) headerLiving.classList.add('is-active');
    var homeItem = document.querySelector('.header__inline-menu a[href="/"]');
    if (homeItem) homeItem.classList.remove('is-active');
  })();
</script>
