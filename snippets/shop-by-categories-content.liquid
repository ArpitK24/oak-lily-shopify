{% comment %}
  Oak & Lily Shop By Categories Grid (/collections)
{% endcomment %}

{{ 'section-collection.css' | asset_url | stylesheet_tag }}

<style>
  .shop-categories-page {
    max-width: 1360px;
    margin: 0 auto;
    padding: 20px 40px 60px;
    box-sizing: border-box;
  }
  @media (max-width: 749px) {
    .shop-categories-page {
      padding: 16px 16px 45px;
    }
  }
  .shop-categories-title {
    font-family: var(--font-heading-family, 'Montserrat', sans-serif);
    font-size: 30px;
    font-weight: 400;
    color: #103f5a;
    letter-spacing: 0.6px;
    margin: 25px 0 24px;
    text-transform: uppercase;
  }
  @media (max-width: 749px) {
    .shop-categories-title {
      font-size: 24px;
      margin: 18px 0 16px;
    }
  }
  .shop-categories-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 28px;
    row-gap: 36px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  @media (max-width: 1024px) {
    .shop-categories-grid {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 20px;
      row-gap: 28px;
    }
  }
  @media (max-width: 749px) {
    .shop-categories-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 14px;
      row-gap: 24px;
    }
  }
  .shop-category-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  .shop-category-media {
    border: 1px solid #103f5a;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    position: relative;
    background: #ffffff;
  }
  .shop-category-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .shop-category-card:hover .shop-category-media img {
    transform: scale(1.03);
  }
  .shop-category-heading {
    margin: 14px 0 0;
    font-family: var(--font-body-family, 'Montserrat', sans-serif);
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.5px;
    color: #103f5a;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .shop-category-heading span.arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .shop-category-card:hover .shop-category-heading span.arrow {
    transform: translateX(4px);
  }
</style>

