{% comment %}
  Oak & Lily Table Linens Collection Content
  Faithful replica using Shopify live products, Shopify CDN media, and authentic layout
{% endcomment %}

{{ 'section-collection.css' | asset_url | stylesheet_tag }}

{%- assign col_key = active_collection | default: collection.handle | default: 'table-linens' -%}

<div class="custom-banner-wrapper">
  <div class="custom-banner">
    <a href="/bundle">
      <picture>
        <img src="{{ 'kitchen-bundle-banner.png' | asset_url }}" alt="Promotional banner" loading="lazy">
      </picture>
    </a>
  </div>
</div>

<div class="collection-hero">
  <div class="collection-hero__inner">
    <h1 class="collection-hero__title" id="table-collection-title-display">
      {% case col_key %}
        {% when 'table-runners' %}TABLE RUNNERS
        {% when 'table-covers' %}TABLE COVERS
        {% when 'placemats' %}PLACEMATS
        {% when 'table-gifts' %}TABLE GIFTS
        {% when 'table-combos' %}TABLE COMBOS
        {% else %}TABLE LINENS
      {% endcase %}
    </h1>
  </div>
</div>

<div class="collection-page">
  <div id="table-collection-grids-wrapper">
    <div class="collection-grid-container" id="grid-container-table-linens" style="display: none;">
      <ul id="product-grid-table-linens" class="collection-product-grid collection-grid-box" data-collection="table-linens">
        {% render 'table-cards-linens' %}
      </ul>
    </div>
    {% render 'table-cards-sub' %}
  </div>
</div>

<script>
  (function() {
    var p = window.location.pathname.toLowerCase();
    var isTable = p.indexOf('/table-') !== -1 || p.indexOf('/placemats') !== -1;
    if (!isTable) return;

    var activeKey = 'table-linens';
    
    if (p.indexOf('/table-runners') !== -1) activeKey = 'table-runners';
    else if (p.indexOf('/table-covers') !== -1) activeKey = 'table-covers';
    else if (p.indexOf('/placemats') !== -1) activeKey = 'placemats';
    else if (p.indexOf('/table-gifts') !== -1) activeKey = 'table-gifts';
    else if (p.indexOf('/table-combos') !== -1) activeKey = 'table-combos';
    else if (p.indexOf('/table-linens') !== -1) activeKey = 'table-linens';

    var titles = {
      'table-runners': 'TABLE RUNNERS',
      'table-covers': 'TABLE COVERS',
      'placemats': 'PLACEMATS',
      'table-gifts': 'TABLE GIFTS',
      'table-combos': 'TABLE COMBOS',
      'table-linens': 'TABLE LINENS'
    };

    var titleEl = document.getElementById('table-collection-title-display');
    if (titleEl && titles[activeKey]) {
      titleEl.textContent = titles[activeKey];
      document.title = titles[activeKey] + ' – OAK AND LILY';
    }

    var targetGrid = document.getElementById('grid-container-' + activeKey);
    if (!targetGrid) targetGrid = document.getElementById('grid-container-table-linens');
    if (targetGrid) targetGrid.style.display = 'block';

    // Highlight TABLE LINENS in header
    var headerTable = document.querySelector('#Details-HeaderMenu-4 summary');
    if (headerTable) headerTable.classList.add('is-active');
    var homeItem = document.querySelector('.header__inline-menu a[href="/"]');
    if (homeItem) homeItem.classList.remove('is-active');
  })();
</script>
