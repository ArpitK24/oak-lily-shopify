{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-primary--family: "Montserrat", {{ settings.type_primary_font.family | default: 'sans-serif' }}, {{ settings.type_primary_font.fallback_families | default: 'sans-serif' }};
    --font-primary--style: {{ settings.type_primary_font.style | default: 'normal' }};
    --font-primary--weight: {{ settings.type_primary_font.weight | default: 400 }};
    --font-heading-family: "Montserrat", sans-serif;
    --font-heading-style: normal;
    --font-heading-weight: 500;
    --font-body-family: "Montserrat", sans-serif;
    --font-body-style: normal;
    --font-body-weight: 400;
    --font-body-weight-bold: 700;
    --page-width: {{ settings.max_page_width | default: '1600px' }};
    --page-margin: {{ settings.min_page_margin | default: 0 }}px;
    {%- assign bg_color = '#f8f4ef' -%}
    {%- if settings.background_color != blank and settings.background_color != '#ffffff' and settings.background_color != '#FFFFFF' -%}
      {%- assign bg_color = settings.background_color -%}
    {%- endif -%}
    {%- assign fg_color = '#0e1b4d' -%}
    {%- if settings.foreground_color != blank and settings.foreground_color != '#333333' and settings.foreground_color != '#000000' -%}
      {%- assign fg_color = settings.foreground_color -%}
    {%- endif -%}
    --color-background: {{ bg_color }};
    --color-foreground: {{ fg_color }};
    --gradient-background: {{ bg_color }};
    --border-radius: 0.0rem;
    --border-width: 0.1rem;
    --border-opacity: 1.0;
    --shadow-opacity: 0.0;
    --font-heading-scale: 1.0;
    --font-body-scale: 1.0;
    --style-border-radius-inputs: {{ settings.input_corner_radius | default: 0 }}px;
  }

  body {
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  body, input, textarea, button, select {
    font-family: var(--font-body-family);
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading-family);
  }
{% endstyle %}
