{% comment %}
  404 template with authentic client-side fallbacks for unconfigured store pages/policies
{% endcomment %}

<script>
  (function() {
    var p = window.location.pathname.toLowerCase();
    if (p.indexOf('/bundle') !== -1 || p.indexOf('/collections/') !== -1 || p.indexOf('/our-story') !== -1 || p.indexOf('/privacy-policy') !== -1 || p.indexOf('/refund-policy') !== -1 || p.indexOf('/shipping-policy') !== -1 || p.indexOf('/terms-of-service') !== -1 || p.indexOf('/contact-information') !== -1 || p.indexOf('/kitchen-napkins') !== -1) {
      document.documentElement.classList.add('has-fallback-route');
    }
  })();
</script>
<style>
  html.has-fallback-route #fallback-404-default { display: none !important; }
</style>

<div id="fallback-404-default" class="template-404 page-width page-margin" style="text-align: center; padding: 80px 20px;">
  <h1 class="title" style="font-family: var(--font-heading-family, 'Montserrat', sans-serif); color: #0e1b4d; font-size: 32px; margin-bottom: 16px;">
    {{ '404.title' | t }}
  </h1>
  <p style="font-family: var(--font-body-family, 'Montserrat', sans-serif); color: rgba(14, 27, 77, 0.75); margin-bottom: 24px;">
    {{ '404.not_found' | t }}
  </p>
  <a href="{{ routes.all_products_collection_url }}" class="button" style="display: inline-block; background-color: #baa431; color: #fff; padding: 12px 28px; text-decoration: none; border-radius: 4px; font-weight: 500;">
    {{ '404.back_to_shopping' | t }}
  </a>
</div>

<div id="fallback-our-story" style="display: none;">
  {% render 'our-story-content' %}
</div>

<div id="fallback-privacy-policy" style="display: none;">
  {% render 'policy-content', policy_handle: 'privacy-policy' %}
</div>

<div id="fallback-refund-policy" style="display: none;">
  {% render 'policy-content', policy_handle: 'refund-policy' %}
</div>

<div id="fallback-terms-of-service" style="display: none;">
  {% render 'policy-content', policy_handle: 'terms-of-service' %}
</div>

<div id="fallback-shipping-policy" style="display: none;">
  {% render 'policy-content', policy_handle: 'shipping-policy' %}
</div>

<div id="fallback-contact-information" style="display: none;">
  {% render 'policy-content', policy_handle: 'contact-information' %}
</div>

<div id="fallback-kitchen-napkins" style="display: none;">
  {% render 'kitchen-napkins-content' %}
</div>

<div id="fallback-bundle" style="display: none;">
  {% render 'bundle-content' %}
</div>

<div id="fallback-kitchen-linens" style="display: none;">
  {% render 'kitchen-linens-content' %}
</div>

<script>
  (function() {
    var p = window.location.pathname.toLowerCase();
    var defaultBox = document.getElementById('fallback-404-default');

    function activate(id, title) {
      if (defaultBox) defaultBox.style.display = 'none';
      var el = document.getElementById(id);
      if (el) el.style.display = 'block';
      if (title) document.title = title + ' – OAK AND LILY';
    }

    if (p.indexOf('/collections/aprons') !== -1) {
      activate('fallback-kitchen-linens', 'Aprons');
    } else if (p.indexOf('/collections/mittens') !== -1) {
      activate('fallback-kitchen-linens', 'Mittens');
    } else if (p.indexOf('/collections/kitchen-napkins') !== -1) {
      activate('fallback-kitchen-linens', 'Kitchen Napkins');
    } else if (p.indexOf('/collections/pot-holders') !== -1) {
      activate('fallback-kitchen-linens', 'Pot Holders');
    } else if (p.indexOf('/collections/kitechen-gifts') !== -1 || p.indexOf('/collections/kitchen-gifts') !== -1) {
      activate('fallback-kitchen-linens', 'Kitchen Gifts');
    } else if (p.indexOf('/collections/kitechen-combos') !== -1 || p.indexOf('/collections/kitchen-combos') !== -1) {
      activate('fallback-kitchen-linens', 'Kitchen Combos');
    } else if (p.indexOf('/collections/kitchen-linens') !== -1) {
      activate('fallback-kitchen-linens', 'Kitchen Linens');
    } else if (p.indexOf('/bundle') !== -1) {
      activate('fallback-bundle', 'Build Your Bundle');
    } else if (p.indexOf('/our-story') !== -1) {
      activate('fallback-our-story', 'Our Story');
    } else if (p.indexOf('/privacy-policy') !== -1) {
      activate('fallback-privacy-policy', 'Privacy policy');
    } else if (p.indexOf('/refund-policy') !== -1) {
      activate('fallback-refund-policy', 'Refund policy');
    } else if (p.indexOf('/shipping-policy') !== -1) {
      activate('fallback-shipping-policy', 'Shipping policy');
    } else if (p.indexOf('/terms-of-service') !== -1) {
      activate('fallback-terms-of-service', 'Terms of service');
    } else if (p.indexOf('/contact-information') !== -1) {
      activate('fallback-contact-information', 'Contact information');
    } else if (p.indexOf('/kitchen-napkins') !== -1) {
      activate('fallback-kitchen-napkins', 'Oak&Lily 100% Pure Cotton Kitchen Napkins');
    }
  })();
</script>

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
