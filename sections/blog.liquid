{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | default: 45 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 45 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | default: 60 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    }
  }

  .main-blog .title--primary {
    font-family: var(--font-heading-family, "Montserrat", sans-serif);
    font-size: 3rem;
    font-weight: 400;
    color: rgb(var(--color-foreground, 14, 27, 77));
    letter-spacing: 0.06rem;
    line-height: calc(1 + 0.3 / max(1, var(--font-heading-scale, 1)));
    margin: 2rem 0;
  }

  @media screen and (min-width: 750px) {
    .main-blog .title--primary {
      margin: 4rem 0 2rem;
    }
  }

  .card--card.color-scheme-1 {
    background-color: var(--color-background, #f8f4ef);
    border: 1px solid rgba(var(--color-foreground, 14, 27, 77), 0.15);
  }

  .blog-articles .card__heading a {
    color: rgb(var(--color-foreground, 14, 27, 77));
    text-decoration: none;
  }

  .blog-articles .card__heading a:hover {
    color: #baa431;
    text-decoration: underline;
  }

  .blog-articles .article-card__info {
    font-size: 1.2rem;
    color: rgba(var(--color-foreground, 14, 27, 77), 0.75);
    letter-spacing: 0.1rem;
    text-transform: uppercase;
  }

  .circle-divider:after {
    content: "\2022";
    margin: 0 1.3rem 0 1.5rem;
  }

  .circle-divider:last-of-type:after {
    display: none;
  }

  .blog-articles .article-card__excerpt {
    font-size: 1.4rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground, 14, 27, 77), 0.75);
    margin-top: 1.2rem;
  }
{%- endstyle -%}

<div class="main-blog page-width section-{{ section.id }}-padding">
  <h1 class="title--primary">
    {%- if section.settings.heading != blank -%}
      {{ section.settings.heading }}
    {%- elsif blog.title != blank and blog.title != 'News' -%}
      {{ blog.title }}
    {%- else -%}
      Oak&amp;Lily 100% Pure Cotton Kitchen Napkins
    {%- endif -%}
  </h1>

  <div class="blog-articles">
    {%- if blog.articles.size > 0 -%}
      {%- for article in blog.articles -%}
        <div class="blog-articles__article article">
          <div class="article-card-wrapper card-wrapper underline-links-hover">
            <div class="card article-card card--card article-card__image--medium card--text color-scheme-1 gradient" style="--ratio-percent: 100%;">
              <div class="card__inner" style="--ratio-percent: 100%;">
                <div class="card__content">
                  <div class="card__information">
                    <h3 class="card__heading h2">
                      <a href="{{ article.url }}" class="full-unstyled-link">
                        {{ article.title }}
                      </a>
                    </h3>
                    <div class="article-card__info caption-with-letter-spacing h5">
                      <span class="circle-divider"><time datetime="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">{{ article.published_at | date: '%B %d, %Y' }}</time></span>
                    </div>
                    {%- if article.excerpt.size > 0 or article.content.size > 0 -%}
                      <p class="article-card__excerpt rte-width">
                        {{ article.excerpt_or_content | strip_html | truncatewords: 30 }}
                      </p>
                    {%- endif -%}
                    <div class="article-card__footer"></div>
                  </div>
                </div>
              </div>
              <div class="card__content">
                <div class="card__information">
                  <h3 class="card__heading h2">
                    <a href="{{ article.url }}" class="full-unstyled-link">
                      {{ article.title }}
                    </a>
                  </h3>
                  <div class="article-card__info caption-with-letter-spacing h5">
                    <span class="circle-divider"><time datetime="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">{{ article.published_at | date: '%B %d, %Y' }}</time></span>
                  </div>
                  {%- if article.excerpt.size > 0 or article.content.size > 0 -%}
                    <p class="article-card__excerpt rte-width">
                      {{ article.excerpt_or_content | strip_html | truncatewords: 30 }}
                    </p>
                  {%- endif -%}
                  <div class="article-card__footer"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="blog-articles__article article">
        <div class="article-card-wrapper card-wrapper underline-links-hover">
          <div class="card article-card card--card article-card__image--medium card--text color-scheme-1 gradient" style="--ratio-percent: 100%;">
            <div class="card__inner" style="--ratio-percent: 100%;">
              <div class="card__content">
                <div class="card__information">
                  <h3 class="card__heading h2">
                    <a href="/blogs/news/kitchen-napkins" class="full-unstyled-link">
                      Oak&amp;Lily 100% Pure Cotton Kitchen Napkins: Prem...
                    </a>
                  </h3>
                  <div class="article-card__info caption-with-letter-spacing h5">
                    <span class="circle-divider"><time datetime="2025-09-28T15:04:44Z">September 28, 2025</time></span>
                  </div>
                  <p class="article-card__excerpt rte-width">
                    Home cooks and kitchen enthusiasts who want reliable, absorbent napkins that actually work will appreciate what Oak&amp;Lily brings to the table. These 100% pure cotton kitchen napkins deliver the performance...
                  </p>
                  <div class="article-card__footer"></div>
                </div>
              </div>
            </div>
            <div class="card__content">
              <div class="card__information">
                <h3 class="card__heading h2">
                  <a href="/blogs/news/kitchen-napkins" class="full-unstyled-link">
                    Oak&amp;Lily 100% Pure Cotton Kitchen Napkins: Prem...
                  </a>
                </h3>
                <div class="article-card__info caption-with-letter-spacing h5">
                  <span class="circle-divider"><time datetime="2025-09-28T15:04:44Z">September 28, 2025</time></span>
                </div>
                <p class="article-card__excerpt rte-width">
                  Home cooks and kitchen enthusiasts who want reliable, absorbent napkins that actually work will appreciate what Oak&amp;Lily brings to the table. These 100% pure cotton kitchen napkins deliver the performance...
                </p>
                <div class="article-card__footer"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Oak&Lily 100% Pure Cotton Kitchen Napkins"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ]
}
{% endschema %}
