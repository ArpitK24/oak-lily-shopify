{{ 'section-hero-banner-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-hero-banner-slider.js' | asset_url }}" defer="defer"></script>

<div
  class="custom-banner-slider full-width"
  data-auto-rotate="{{ section.settings.auto_rotate }}"
  data-speed="{{ section.settings.change_slides_speed | times: 1000 }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_label | default: 'Hero Banner Slider' | escape }}"
>
  <div class="banner-slider">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign slide_url = block.settings.link | default: routes.all_products_collection_url -%}
        {%- assign alt_text = block.settings.alt_text | default: shop.name | escape -%}

        <div
          class="banner-slide"
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} of {{ forloop.length }}"
          {{ block.shopify_attributes }}
        >
          <a href="{{ slide_url }}" class="banner-link">
            {%- if block.settings.image_desktop != blank -%}
              {{
                block.settings.image_desktop
                | image_url: width: 1920
                | image_tag:
                  class: 'banner-image desktop-banner',
                  loading: 'eager',
                  fetchpriority: 'high',
                  alt: alt_text
              }}
            {%- else -%}
              {%- assign slide_idx = forloop.index | modulo: 3 -%}
              {%- if slide_idx == 1 -%}
                <img
                  src="{{ 'hero-slide-1-desktop.png' | asset_url }}"
                  alt="{{ alt_text }}"
                  width="1920"
                  height="630"
                  class="banner-image desktop-banner"
                  loading="eager"
                  fetchpriority="high"
                >
              {%- elsif slide_idx == 2 -%}
                <img
                  src="{{ 'hero-slide-2-desktop.jpg' | asset_url }}"
                  alt="{{ alt_text }}"
                  width="1920"
                  height="630"
                  class="banner-image desktop-banner"
                  loading="eager"
                  fetchpriority="high"
                >
              {%- else -%}
                <img
                  src="{{ 'hero-slide-3-desktop.png' | asset_url }}"
                  alt="{{ alt_text }}"
                  width="1920"
                  height="630"
                  class="banner-image desktop-banner"
                  loading="eager"
                  fetchpriority="high"
                >
              {%- endif -%}
            {%- endif -%}

            {%- if block.settings.image_mobile != blank -%}
              {{
                block.settings.image_mobile
                | image_url: width: 800
                | image_tag: class: 'banner-image mobile-banner', loading: 'eager', alt: alt_text
              }}
            {%- else -%}
              {%- assign slide_idx = forloop.index | modulo: 3 -%}
              {%- if slide_idx == 1 -%}
                <img
                  src="{{ 'hero-slide-1-mobile.png' | asset_url }}"
                  alt="{{ alt_text }}"
                  width="800"
                  height="1000"
                  class="banner-image mobile-banner"
                  loading="eager"
                >
              {%- elsif slide_idx == 2 -%}
                <img
                  src="{{ 'hero-slide-2-mobile.jpg' | asset_url }}"
                  alt="{{ alt_text }}"
                  width="800"
                  height="1000"
                  class="banner-image mobile-banner"
                  loading="eager"
                >
              {%- else -%}
                <img
                  src="{{ 'hero-slide-3-mobile.png' | asset_url }}"
                  alt="{{ alt_text }}"
                  width="800"
                  height="1000"
                  class="banner-image mobile-banner"
                  loading="eager"
                >
              {%- endif -%}
            {%- endif -%}
          </a>
        </div>
      {%- endfor -%}
    {%- else -%}
      {% comment %} Fallback default 3 Oak & Lily hero slides {% endcomment %}
      <div class="banner-slide" role="group" aria-roledescription="slide" aria-label="1 of 3">
        <a href="{{ routes.all_products_collection_url }}" class="banner-link">
          <img
            src="{{ 'hero-slide-1-desktop.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="1920"
            height="630"
            class="banner-image desktop-banner"
            loading="eager"
            fetchpriority="high"
          >
          <img
            src="{{ 'hero-slide-1-mobile.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="800"
            height="1000"
            class="banner-image mobile-banner"
            loading="eager"
          >
        </a>
      </div>

      <div class="banner-slide" role="group" aria-roledescription="slide" aria-label="2 of 3">
        <a href="{{ routes.all_products_collection_url }}" class="banner-link">
          <img
            src="{{ 'hero-slide-2-desktop.jpg' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="1920"
            height="630"
            class="banner-image desktop-banner"
            loading="eager"
            fetchpriority="high"
          >
          <img
            src="{{ 'hero-slide-2-mobile.jpg' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="800"
            height="1000"
            class="banner-image mobile-banner"
            loading="eager"
          >
        </a>
      </div>

      <div class="banner-slide" role="group" aria-roledescription="slide" aria-label="3 of 3">
        <a href="{{ routes.all_products_collection_url }}" class="banner-link">
          <img
            src="{{ 'hero-slide-3-desktop.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="1920"
            height="630"
            class="banner-image desktop-banner"
            loading="eager"
            fetchpriority="high"
          >
          <img
            src="{{ 'hero-slide-3-mobile.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="800"
            height="1000"
            class="banner-image mobile-banner"
            loading="eager"
          >
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero banner slider",
  "tag": "section",
  "class": "section-hero-banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 4
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Hero Banner Slider"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop image (1920 x 630 px recommended)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image (800 x 1000 px recommended)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
