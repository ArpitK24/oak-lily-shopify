{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer class="footer footer-section-padding full-width" role="contentinfo">
  <div class="footer__content-top page-width">
    <div class="footer__blocks-wrapper">
      {% comment %} Block 1: QUICK LINKS {% endcomment %}
      <div class="footer-block footer-block--menu">
        <h2 class="footer-block__heading inline-richtext">
          {{ section.settings.menu_1_heading | default: 'QUICK LINKS' | escape }}
        </h2>
        <ul class="footer-block__details-content list-unstyled" role="list">
          {%- if section.settings.menu_1 != blank and section.settings.menu_1.links.size > 0 -%}
            {%- for link in section.settings.menu_1.links -%}
              <li>
                <a
                  href="{{ link.url }}"
                  class="link link--text list-menu__item list-menu__item--link{% if link.current or forloop.first %} list-menu__item--active{% endif %}"
                >
                  {{ link.title | upcase | escape }}
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/" class="link link--text list-menu__item list-menu__item--link list-menu__item--active">HOME</a></li>
            <li><a href="/pages/our-story" class="link link--text list-menu__item list-menu__item--link">OUR STORY</a></li>
            <li><a href="/collections/kitchen-linens" class="link link--text list-menu__item list-menu__item--link">KITCHEN LINENS</a></li>
            <li><a href="/collections/table-linens" class="link link--text list-menu__item list-menu__item--link">TABLE LINENS</a></li>
            <li><a href="/collections/bed-linens" class="link link--text list-menu__item list-menu__item--link">BED LINENS</a></li>
            <li><a href="/collections/living-space" class="link link--text list-menu__item list-menu__item--link">LIVING SPACES</a></li>
            <li><a href="/collections" class="link link--text list-menu__item list-menu__item--link">GIFTS</a></li>
            <li><a href="/blogs/news" class="link link--text list-menu__item list-menu__item--link">BLOGS</a></li>
          {%- endif -%}
        </ul>
      </div>

      {% comment %} Block 2: LOGISTICS {% endcomment %}
      <div class="footer-block footer-block--menu">
        <h2 class="footer-block__heading inline-richtext">
          {{ section.settings.menu_2_heading | default: 'LOGISTICS' | escape }}
        </h2>
        <ul class="footer-block__details-content list-unstyled" role="list">
          {%- if section.settings.menu_2 != blank and section.settings.menu_2.links.size > 0 -%}
            {%- for link in section.settings.menu_2.links -%}
              <li>
                <a href="{{ link.url }}" class="link link--text list-menu__item list-menu__item--link">
                  {{ link.title | upcase | escape }}
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="#" class="link link--text list-menu__item list-menu__item--link">TRACK ORDER</a></li>
          {%- endif -%}
        </ul>
      </div>

      {% comment %} Block 3: POLICIES {% endcomment %}
      <div class="footer-block footer-block--menu">
        <h2 class="footer-block__heading inline-richtext">
          {{ section.settings.menu_3_heading | default: 'POLICIES' | escape }}
        </h2>
        <ul class="footer-block__details-content list-unstyled" role="list">
          {%- if section.settings.menu_3 != blank and section.settings.menu_3.links.size > 0 -%}
            {%- for link in section.settings.menu_3.links -%}
              <li>
                <a href="{{ link.url }}" class="link link--text list-menu__item list-menu__item--link">
                  {{ link.title | upcase | escape }}
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/policies/contact-information" class="link link--text list-menu__item list-menu__item--link">CONTACT INFORMATION</a></li>
            <li><a href="/policies/privacy-policy" class="link link--text list-menu__item list-menu__item--link">PRIVACY POLICY</a></li>
            <li><a href="/policies/refund-policy" class="link link--text list-menu__item list-menu__item--link">REFUND POLICY</a></li>
            <li><a href="/policies/shipping-policy" class="link link--text list-menu__item list-menu__item--link">SHIPPING POLICY</a></li>
            <li><a href="/policies/terms-of-service" class="link link--text list-menu__item list-menu__item--link">TERMS OF SERVICE</a></li>
          {%- endif -%}
        </ul>
      </div>

      {% comment %} Block 4: CONTACT US {% endcomment %}
      <div class="footer-block">
        <h2 class="footer-block__heading inline-richtext">
          {{ section.settings.contact_heading | default: 'CONTACT US' | escape }}
        </h2>
        <div class="footer-block__details-content rte">
          <p>
            AVARAH LIFESTYLES LLP<br>
            B 1204, HILLCREST<br>
            HOUSE OF HIRANANDANI<br>
            BEGUR HULIMAVU ROAD,<br>
            AKSHAYANAGAR<br>
            BANGALORE -<br>
            560068, KARNATAKA
          </p>
          <p>GSTIN 29ACDFA8032H1ZF</p>
          <p>
            Mob: <a href="tel:+918088743076" class="footer__contact-link">+91 8088 743 076</a>,
            <a href="tel:+918088749569" class="footer__contact-link">+91 8088 749 569</a>
          </p>
          <p>Email: <a href="mailto:help@oakandlily.in" class="footer__contact-link">help@oakandlily.in</a></p>
        </div>
      </div>
    </div>

    {% comment %} Newsletter & Social Links {% endcomment %}
    <div class="footer-block--newsletter">
      <div class="footer-block__newsletter">
        <h2 class="footer-block__newsletter-heading">
          {{ section.settings.newsletter_heading | default: 'Subscribe to our emails' | escape }}
        </h2>
        {%- form 'customer', class: 'footer__newsletter newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter-form__field-wrapper">
            <div class="field">
              <input
                id="NewsletterForm--{{ section.id }}"
                type="email"
                name="contact[email]"
                class="field__input"
                value=""
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="Email"
                required
              >
              <button
                type="submit"
                class="newsletter-form__button field__button"
                name="commit"
                id="Subscribe-{{ section.id }}"
                aria-label="Subscribe"
              >
                <svg viewBox="0 0 14 10" fill="none" aria-hidden="true" focusable="false" class="icon icon-arrow">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor"/>
                </svg>
              </button>
            </div>
          </div>
        {%- endform -%}
      </div>

      {%- if section.settings.show_social -%}
        <ul class="list-unstyled list-social footer__list-social" role="list">
          <li class="list-social__item">
            <a
              href="{{ section.settings.facebook_url | default: '#' }}"
              class="link list-social__link"
              aria-label="Facebook"
              target="_blank"
              rel="noopener"
            >
              <svg aria-hidden="true" focusable="false" class="icon icon-facebook" viewBox="0 0 20 20">
                <path fill="currentColor" d="M18 10.049C18 5.603 14.419 2 10 2c-4.419 0-8 3.603-8 8.049C2 14.067 4.925 17.396 8.75 18v-5.624H6.719v-2.328h2.03V8.275c0-2.017 1.195-3.132 3.023-3.132.874 0 1.79.158 1.79.158v1.98h-1.009c-.994 0-1.303.621-1.303 1.258v1.51h2.219l-.355 2.326H11.25V18c3.825-.604 6.75-3.933 6.75-7.951Z"/>
              </svg>
              <span class="visually-hidden">Facebook</span>
            </a>
          </li>
          <li class="list-social__item">
            <a
              href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/oak.and.lily/' }}"
              class="link list-social__link"
              aria-label="Instagram"
              target="_blank"
              rel="noopener"
            >
              <svg aria-hidden="true" focusable="false" class="icon icon-instagram" viewBox="0 0 20 20">
                <path fill="currentColor" fill-rule="evenodd" d="M13.23 3.492c-.84-.037-1.096-.046-3.23-.046-2.144 0-2.39.01-3.238.055-.776.027-1.195.164-1.487.273a2.43 2.43 0 0 0-.912.593 2.486 2.486 0 0 0-.602.922c-.11.282-.238.702-.274 1.486-.046.84-.046 1.095-.046 3.23 0 2.134.01 2.39.046 3.229.004.51.097 1.016.274 1.495.145.365.319.639.602.913.282.282.538.456.92.602.474.176.974.268 1.479.273.848.046 1.103.046 3.238.046 2.134 0 2.39-.01 3.23-.046.784-.036 1.203-.164 1.486-.273.374-.146.648-.329.921-.602.283-.283.447-.548.602-.922.177-.476.27-.979.274-1.486.037-.84.046-1.095.046-3.23 0-2.134-.01-2.39-.055-3.229-.027-.784-.164-1.204-.274-1.495a2.43 2.43 0 0 0-.593-.913 2.604 2.604 0 0 0-.92-.602c-.284-.11-.703-.237-1.488-.273ZM6.697 2.05c.857-.036 1.131-.045 3.302-.045 1.1-.014 2.202.001 3.302.045.664.014 1.321.14 1.943.374a3.968 3.968 0 0 1 1.414.922c.41.397.728.88.93 1.414.23.622.354 1.279.365 1.942C18 7.56 18 7.824 18 10.005c0 2.17-.01 2.444-.046 3.292-.036.858-.173 1.442-.374 1.943-.2.53-.474.976-.92 1.423a3.896 3.896 0 0 1-1.415.922c-.51.191-1.095.337-1.943.374-.857.036-1.122.045-3.302.045-2.171 0-2.445-.009-3.302-.055-.849-.027-1.432-.164-1.943-.364a4.152 4.152 0 0 1-1.414-.922 4.128 4.128 0 0 1-.93-1.423c-.183-.51-.329-1.085-.365-1.943C2.009 12.45 2 12.167 2 10.004c0-2.161 0-2.435.055-3.302.027-.848.164-1.432.365-1.942a4.44 4.44 0 0 1 .92-1.414 4.18 4.18 0 0 1 1.415-.93c.51-.183 1.094-.33 1.943-.366Zm.427 4.806a4.105 4.105 0 1 1 5.805 5.805 4.105 4.105 0 0 1-5.805-5.805Zm1.882 5.371a2.668 2.668 0 1 0 2.042-4.93 2.668 2.668 0 0 0-2.042 4.93Zm5.922-5.942a.958.958 0 1 1-1.355-1.355.958.958 0 0 1 1.355 1.355Z" clip-rule="evenodd"/>
              </svg>
              <span class="visually-hidden">Instagram</span>
            </a>
          </li>
        </ul>
      {%- endif -%}
    </div>
  </div>

  {% comment %} Footer Bottom Row {% endcomment %}
  <div class="footer__content-bottom">
    <div class="footer__content-bottom-wrapper page-width">
      <div class="footer__copyright">
        <small class="copyright__content">© {{ 'now' | date: '%Y' }}, <a href="{{ routes.root_url }}">OAK AND LILY</a></small>
      </div>

      <ul class="policies list-unstyled" role="list">
        {%- if shop.policies.size >= 5 -%}
          {%- for policy in shop.policies -%}
            <li>
              <small class="copyright__content"><a href="{{ policy.url }}">{{ policy.title }}</a></small>
            </li>
          {%- endfor -%}
        {%- else -%}
          <li><small class="copyright__content"><a href="/policies/refund-policy">Refund policy</a></small></li>
          <li><small class="copyright__content"><a href="/policies/privacy-policy">Privacy policy</a></small></li>
          <li><small class="copyright__content"><a href="/policies/terms-of-service">Terms of service</a></small></li>
          <li><small class="copyright__content"><a href="/policies/shipping-policy">Shipping policy</a></small></li>
          <li><small class="copyright__content"><a href="/policies/contact-information">Contact information</a></small></li>
        {%- endif -%}
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "menu_1_heading",
      "label": "Menu 1 heading",
      "default": "QUICK LINKS"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Quick links menu"
    },
    {
      "type": "text",
      "id": "menu_2_heading",
      "label": "Menu 2 heading",
      "default": "LOGISTICS"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Logistics menu"
    },
    {
      "type": "text",
      "id": "menu_3_heading",
      "label": "Menu 3 heading",
      "default": "POLICIES"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Policies menu"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "CONTACT US"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Subscribe to our emails"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook link"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram link"
    }
  ]
}
{% endschema %}
