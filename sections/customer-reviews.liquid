{{ 'section-customer-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-customer-reviews.js' | asset_url }}" defer="defer"></script>

<div
  class="customer-reviews-section full-width"
  role="region"
  aria-label="{{ section.settings.heading | default: 'Hear It From Our Happy Clients' | escape }}"
>
  <div
    class="jdgm-widget jdgm-testimonials-carousel"
    data-jdgm-block-id="AeTJCWkQwUTdDRExoc__judge_me_reviews_testimonials_carousel_38XeVA"
    role="region"
    aria-roledescription="carousel"
    aria-label="Customer reviews"
    data-widget="testimonials-carousel"
    data-has-revamp="1"
    style="--max-width: 1100px; --text-color: #103f5a; --card-color: #f8f4ef; --border-radius: 8px; --border: none; --box-shadow: 0px 0px 40px 0px #D0D0D0; --quote-size: 24px; --quote-aspect: 1.52; --text-size: 24px; --text-size-mobile: 20px; --line-clamp: 3; --line-clamp-mobile: 4; --stars-size: 24px; --stars-color: #e7be27; --product-name-size: 16px; --arrows-color: #000000; --slides-count: 20;"
  >
    <div class="jdgm-header">
      <h2 class="jdgm-title">
        {{ section.settings.heading | default: 'Hear It From Our Happy Clients' | escape }}
      </h2>

      <div class="jdgm-header-info">
        <div class="jdgm-average-rating">
          <div class="jdgm-stars" role="img" aria-label="4.7 out of 5 stars">
            <span class="jdgm-star jdgm--on" aria-hidden="true"></span>
            <span class="jdgm-star jdgm--on" aria-hidden="true"></span>
            <span class="jdgm-star jdgm--on" aria-hidden="true"></span>
            <span class="jdgm-star jdgm--on" aria-hidden="true"></span>
            <span class="jdgm-star jdgm--half" aria-hidden="true"></span>
          </div>
          <span class="jdgm-rating-text">
            {{ section.settings.rating_text | default: '4.70' }} <span class="jdgm-rating-star">★</span> (
            <span class="jdgm-reviews-count">{{ section.settings.reviews_count | default: '319' }}</span>)
          </span>
        </div>

        <div class="jdgm-verified-badge-header">
          <svg class="jdgm-verified-checkmark" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M1.14026 0C0.510511 0 0 0.510511 0 1.14026V18.8599C0 19.4896 0.510511 20.0001 1.14026 20.0001H18.8597C19.4895 20.0001 20 19.4896 20 18.8599V11.3685C20 11.008 19.5606 10.8315 19.3112 11.0918L15.3614 15.2135C13.6736 16.9747 11.912 17.8504 10.0763 17.8407C8.25519 17.8454 6.52568 17.0288 4.8878 15.391C3.14847 13.6516 2.23211 11.7644 2.13874 9.72917C2.06539 7.84992 2.79892 6.0381 4.33936 4.29371C4.5345 4.07273 4.86976 4.0698 5.07804 4.27808L8.5462 7.74623C8.75271 7.95274 8.75486 8.28861 8.57448 8.51907C7.73628 9.59004 7.70456 10.5129 8.47933 11.2877C9.26203 12.0704 10.1356 11.9585 11.1 10.9521L19.8888 1.78078C19.9602 1.70632 20 1.60716 20 1.50403V1.14026C20 0.510511 19.4895 0 18.8597 0H1.14026Z"/>
          </svg>
          <span class="jdgm-verified-text">Verified</span>
        </div>
      </div>
    </div>

    <div class="jdgm-content">
      <div class="jdgm-testimonials-container">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign product = block.settings.product -%}
            <div
              class="jdgm-card jdgm-testimonial jdgm-carousel-item{% if forloop.first %} active{% endif %}"
              data-card-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <div class="jdgm-card-content">
                <i class="jdgm-quote-marks" aria-hidden="true"></i>
                <div class="jdgm-text"><p>{{ block.settings.review_text | escape }}</p></div>

                <div class="jdgm-rating-section">
                  <div class="jdgm-stars">
                    {%- assign rating_val = block.settings.rating | default: 5 -%}
                    {%- for i in (1..5) -%}
                      {%- if i <= rating_val -%}
                        <span class="jdgm-star jdgm--on"></span>
                      {%- else -%}
                        <span class="jdgm-star jdgm--off"></span>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  <div class="jdgm-reviewer-info">
                    <span class="jdgm-reviewer-name">{{ block.settings.author | escape }}</span>
                    <span class="jdgm-reviewer-verified-icon"></span>
                  </div>
                </div>

                {%- if product != blank -%}
                  <div class="jdgm-product-name">
                    <a href="{{ product.url }}">{{ product.title | escape }}</a>
                  </div>
                {%- elsif block.settings.product_title != blank -%}
                  <div class="jdgm-product-name">
                    <span>{{ block.settings.product_title | escape }}</span>
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
