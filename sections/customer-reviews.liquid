{% schema %}
{
  "name": "Customer reviews",
  "tag": "section",
  "class": "section-customer-reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hear It From Our Happy Clients"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating score",
      "default": "4.70"
    },
    {
      "type": "text",
      "id": "reviews_count",
      "label": "Review count",
      "default": "319"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review card",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Reviewer name",
          "default": "Mona Singh"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review text",
          "default": "I recently received the cushion covers and throw from Oak and Lily, and I’m really pleased with them. The cushion covers are beautifully made, with a lovely design and soft, good-quality fabric."
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star rating"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product name (text)",
          "default": "Oak & Lily 100% Cotton Sofa Throw Blanket"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Reviewed product (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer reviews"
    }
  ]
}
{% endschema %}
