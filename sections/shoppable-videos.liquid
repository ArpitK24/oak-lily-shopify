{{ 'section-shoppable-videos.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-shoppable-videos.js' | asset_url }}" defer="defer"></script>

<div
  class="shoppable-video-carousel full-width"
  role="region"
  aria-label="{{ section.settings.heading | default: 'Shoppable Videos' | escape }}"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="carousel" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign card_idx = forloop.index | modulo: 7 -%}
          {%- if card_idx == 0 -%}{%- assign card_idx = 7 -%}{%- endif -%}

          {%- assign product = block.settings.product -%}

          <div
            class="video-card"
            role="listitem"
            {{ block.shopify_attributes }}
          >
            <div class="video-wrapper">
              {%- if block.settings.video != blank -%}
                {{
                  block.settings.video
                  | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, preload: 'metadata'
                }}
              {%- elsif block.settings.video_url != blank -%}
                <video autoplay loop muted playsinline preload="metadata">
                  <source src="{{ block.settings.video_url }}" type="video/mp4">
                </video>
              {%- else -%}
                {%- capture fallback_video -%}shoppable-video-{{ card_idx }}.mp4{%- endcapture -%}
                <video autoplay loop muted playsinline preload="metadata">
                  <source src="{{ fallback_video | asset_url }}" type="video/mp4">
                </video>
              {%- endif -%}
            </div>

            {%- if product != blank -%}
              <a href="{{ product.url }}" class="product-overlay">
                {%- if product.featured_image != blank -%}
                  {{
                    product.featured_image
                    | image_url: width: 80, height: 80
                    | image_tag: width: 40, height: 40, alt: product.title, loading: 'lazy'
                  }}
                {%- endif -%}
                <div class="product-info">
                  <p>{{ product.title | escape }}</p>
                  <span class="price">{{ product.price | money }}</span>
                </div>
              </a>
            {%- else -%}
              {%- assign fallback_url = routes.all_products_collection_url -%}
              {%- capture fallback_thumb -%}shoppable-thumb-{{ card_idx }}.{%- if card_idx == 7 -%}png{%- else -%}jpg{%- endif -%}{%- endcapture -%}

              {%- case card_idx -%}
                {%- when 1 -%}
                  {%- assign fallback_title = 'Oak & Lily Green Leaves Cotton Cushion Cover | 100% Pure Cotton | Soft, Durable & Washable | European Quality' -%}
                  {%- assign fallback_price = '₹ 699.00' -%}
                {%- when 2 -%}
                  {%- assign fallback_title = 'Ivory & Grey Elephant Print Table Runner & Placemats Set' -%}
                  {%- assign fallback_price = '₹ 1,299.00' -%}
                {%- when 3 -%}
                  {%- assign fallback_title = 'Vintage Petal King Bedsheet 210 TC' -%}
                  {%- assign fallback_price = '₹ 1,699.00' -%}
                {%- when 4 -%}
                  {%- assign fallback_title = 'Red Poppy Flower Print Kitchen Linen Set | Apron with Kitchen Napkins & Pot Holder' -%}
                  {%- assign fallback_price = '₹ 1,199.00' -%}
                {%- when 5 -%}
                  {%- assign fallback_title = 'Peach Print Kitchen Napkins | Set of 3' -%}
                  {%- assign fallback_price = '₹ 449.00' -%}
                {%- when 6 -%}
                  {%- assign fallback_title = 'Pastel Flora King Bedsheet 210 TC' -%}
                  {%- assign fallback_price = '₹ 1,699.00' -%}
                {%- when 7 -%}
                  {%- assign fallback_title = 'Oak & Lily Table Runner – Yellow & Green Lemon Print | 100% Cotton | Premium European Quality' -%}
                  {%- assign fallback_price = '₹ 699.00' -%}
              {%- endcase -%}

              <a href="{{ fallback_url }}" class="product-overlay">
                <img
                  src="{{ fallback_thumb | asset_url }}"
                  alt="{{ fallback_title | escape }}"
                  width="40"
                  height="40"
                  loading="lazy"
                >
                <div class="product-info">
                  <p>{{ fallback_title | escape }}</p>
                  <span class="price">{{ fallback_price }}</span>
                </div>
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {% comment %} Fallback default 7 cards {% endcomment %}
        {%- for i in (1..7) -%}
          {%- capture fallback_video -%}shoppable-video-{{ i }}.mp4{%- endcapture -%}
          {%- capture fallback_thumb -%}shoppable-thumb-{{ i }}.{%- if i == 7 -%}png{%- else -%}jpg{%- endif -%}{%- endcapture -%}

          {%- case i -%}
            {%- when 1 -%}
              {%- assign fallback_title = 'Oak & Lily Green Leaves Cotton Cushion Cover | 100% Pure Cotton | Soft, Durable & Washable | European Quality' -%}
              {%- assign fallback_price = '₹ 699.00' -%}
            {%- when 2 -%}
              {%- assign fallback_title = 'Ivory & Grey Elephant Print Table Runner & Placemats Set' -%}
              {%- assign fallback_price = '₹ 1,299.00' -%}
            {%- when 3 -%}
              {%- assign fallback_title = 'Vintage Petal King Bedsheet 210 TC' -%}
              {%- assign fallback_price = '₹ 1,699.00' -%}
            {%- when 4 -%}
              {%- assign fallback_title = 'Red Poppy Flower Print Kitchen Linen Set | Apron with Kitchen Napkins & Pot Holder' -%}
              {%- assign fallback_price = '₹ 1,199.00' -%}
            {%- when 5 -%}
              {%- assign fallback_title = 'Peach Print Kitchen Napkins | Set of 3' -%}
              {%- assign fallback_price = '₹ 449.00' -%}
            {%- when 6 -%}
              {%- assign fallback_title = 'Pastel Flora King Bedsheet 210 TC' -%}
              {%- assign fallback_price = '₹ 1,699.00' -%}
            {%- when 7 -%}
              {%- assign fallback_title = 'Oak & Lily Table Runner – Yellow & Green Lemon Print | 100% Cotton | Premium European Quality' -%}
              {%- assign fallback_price = '₹ 699.00' -%}
          {%- endcase -%}

          <div class="video-card" role="listitem">
            <div class="video-wrapper">
              <video autoplay loop muted playsinline preload="metadata">
                <source src="{{ fallback_video | asset_url }}" type="video/mp4">
              </video>
            </div>
            <a href="{{ routes.all_products_collection_url }}" class="product-overlay">
              <img
                src="{{ fallback_thumb | asset_url }}"
                alt="{{ fallback_title | escape }}"
                width="40"
                height="40"
                loading="lazy"
              >
              <div class="product-info">
                <p>{{ fallback_title | escape }}</p>
                <span class="price">{{ fallback_price }}</span>
              </div>
            </a>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shoppable videos",
  "tag": "section",
  "class": "section-shoppable-videos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Featured product"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (Shopify hosted)"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Custom video URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable videos",
      "blocks": [
        { "type": "video_card" },
        { "type": "video_card" },
        { "type": "video_card" },
        { "type": "video_card" },
        { "type": "video_card" },
        { "type": "video_card" },
        { "type": "video_card" }
      ]
    }
  ]
}
{% endschema %}
