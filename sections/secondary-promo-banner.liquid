{{ 'section-secondary-promo-banner.css' | asset_url | stylesheet_tag }}

<div
  class="secondary-promo-banner full-width"
  role="region"
  aria-label="{{ section.settings.heading | default: 'Promotional Banner' | escape }}"
>
  <div class="secondary-promo-banner__container{% if section.settings.image_mobile != blank %} has-mobile-image{% endif %}">
    {%- assign banner_url = section.settings.link | default: section.settings.button_link -%}

    {%- if banner_url != blank -%}
      <a href="{{ banner_url }}" class="secondary-promo-banner__link">
    {%- endif -%}

    {%- if section.settings.image_desktop != blank -%}
      {{
        section.settings.image_desktop
        | image_url: width: 1920
        | image_tag:
          class: 'secondary-promo-banner__image desktop-banner',
          widths: '750, 1100, 1500, 1920',
          loading: 'lazy',
          alt: section.settings.heading | default: shop.name
      }}

      {%- if section.settings.image_mobile != blank -%}
        {{
          section.settings.image_mobile
          | image_url: width: 768
          | image_tag:
            class: 'secondary-promo-banner__image mobile-banner',
            widths: '375, 550, 768',
            loading: 'lazy',
            alt: section.settings.heading | default: shop.name
        }}
      {%- else -%}
        {{
          section.settings.image_desktop
          | image_url: width: 768
          | image_tag:
            class: 'secondary-promo-banner__image mobile-banner',
            widths: '375, 550, 768',
            loading: 'lazy',
            alt: section.settings.heading | default: shop.name
        }}
      {%- endif -%}
    {%- else -%}
      <img
        src="{{ 'promo-banner-desktop.png' | asset_url }}"
        alt="{{ section.settings.heading | default: 'Pure European Elegance for Your Home' | escape }}"
        class="secondary-promo-banner__image desktop-banner"
        loading="lazy"
        width="1920"
        height="229"
      >
    {%- endif -%}

    {%- if section.settings.heading != blank and section.settings.image_desktop != blank -%}
      <div class="secondary-promo-banner__content">
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p>{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <span class="secondary-promo-banner__btn">{{ section.settings.button_label | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if banner_url != blank -%}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Secondary promo banner",
  "tag": "section",
  "class": "section-secondary-promo-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image (1920x230 recommended)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image (optional)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner link"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overlay heading (optional)"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Overlay subheading (optional)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label (optional)"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link (optional)"
    }
  ],
  "presets": [
    {
      "name": "Secondary promo banner"
    }
  ]
}
{% endschema %}
