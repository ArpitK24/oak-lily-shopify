{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- assign active_view = template.suffix | default: page.handle -%}

{%- if active_view == 'bundle' -%}
  {% render 'bundle-content' %}
{%- elsif active_view == 'our-story' -%}
  {% render 'our-story-content' %}
{%- elsif active_view == 'refund-policy' or active_view == 'privacy-policy' or active_view == 'terms-of-service' or active_view == 'shipping-policy' or active_view == 'contact-information' -%}
  {% render 'policy-content', policy_handle: active_view %}
{%- elsif active_view == 'kitchen-napkins' -%}
  {% render 'kitchen-napkins-content' %}
{%- else -%}
  <div class="main-page page-width page-width--narrow">
    <h1 class="main-page__title">{{ page.title | escape }}</h1>
    <div class="main-page__content rte">
      {{ page.content }}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
