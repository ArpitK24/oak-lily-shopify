{{ 'section-build-your-bundle.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-build-your-bundle.js' | asset_url }}" defer="defer"></script>

<div
  class="oak-bundle-section full-width"
  role="region"
  aria-label="{{ section.settings.heading | default: 'Build your bundle' | escape }}"
>
  <div class="oak-bundle-banner">
    <h2>{{ section.settings.heading | default: 'BUILD YOUR OWN BUNDLE' | escape }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="oak-bundle-banner__desc">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- if section.settings.tier_text != blank -%}
      <p class="oak-bundle-banner__tier">{{ section.settings.tier_text | escape }}</p>
    {%- endif -%}
    {%- assign bundle_link = section.settings.button_link | default: routes.all_products_collection_url -%}
    <a href="{{ bundle_link }}" class="button oak-bundle-banner__cta">
      {{ section.settings.button_label | default: 'BUILD YOUR BUNDLE' | escape }}
    </a>
  </div>

  {%- if section.settings.show_combos_slider -%}
    <div class="sldOuter1">
      {%- if section.settings.combos_heading != blank -%}
        <h2 class="title-head">{{ section.settings.combos_heading | escape }}</h2>
      {%- endif -%}

      <div class="combos-carousel-track" role="list">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign product = block.settings.product -%}
            {%- assign item_url = block.settings.link | default: product.url | default: bundle_link -%}
            {%- assign item_title = block.settings.title | default: product.title | default: 'Gifting Combo' -%}

            <div class="combos-slide-item" role="listitem" {{ block.shopify_attributes }}>
              <a href="{{ item_url }}">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 600, height: 600
                    | image_tag: width: 300, height: 300, loading: 'lazy', alt: item_title
                  }}
                {%- elsif product != blank and product.featured_image != blank -%}
                  {{
                    product.featured_image
                    | image_url: width: 600, height: 600
                    | image_tag: width: 300, height: 300, loading: 'lazy', alt: item_title
                  }}
                {%- else -%}
                  <div class="combos-placeholder-card">
                    <span>{{ item_title | escape }}</span>
                  </div>
                {%- endif -%}
              </a>
            </div>
          {%- endfor -%}
        {%- elsif section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
          {%- for product in section.settings.collection.products limit: 8 -%}
            <div class="combos-slide-item" role="listitem">
              <a href="{{ product.url }}">
                {%- if product.featured_image != blank -%}
                  {{
                    product.featured_image
                    | image_url: width: 600, height: 600
                    | image_tag: width: 300, height: 300, loading: 'lazy', alt: product.title
                  }}
                {%- endif -%}
              </a>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Build your bundle",
  "tag": "section",
  "class": "section-build-your-bundle",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Banner heading",
      "default": "BUILD YOUR OWN BUNDLE"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Banner subheading",
      "default": "Pick your favourite Oak & Lily products and save more when you bundle."
    },
    {
      "type": "text",
      "id": "tier_text",
      "label": "Discount tiers text",
      "default": "BUY 2 → SAVE 10%   |   BUY 3 → SAVE 15%"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "CTA button label",
      "default": "BUILD YOUR BUNDLE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "CTA button link"
    },
    {
      "type": "checkbox",
      "id": "show_combos_slider",
      "label": "Show combos carousel",
      "default": true
    },
    {
      "type": "text",
      "id": "combos_heading",
      "label": "Combos section heading",
      "default": "GIFTING COMBOS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Optional combo products collection"
    }
  ],
  "blocks": [
    {
      "type": "combo_item",
      "name": "Combo item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Shopify product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional override)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title (optional override)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional override)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Build your bundle",
      "blocks": [
        { "type": "combo_item" },
        { "type": "combo_item" },
        { "type": "combo_item" },
        { "type": "combo_item" }
      ]
    }
  ]
}
{% endschema %}
