{{ 'section-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-header.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #shopify-section-{{ section.id }} {
    --header-bg: {{ section.settings.background_color }};
    --header-color: {{ section.settings.text_color }};
    --header-logo-width: {{ section.settings.logo_width }}px;
  }
{%- endstyle -%}

{%- assign nav_menu = section.settings.menu.links | default: linklists.main-menu.links -%}

<div class="oak-header-wrapper full-width{% if section.settings.enable_sticky_header %} oak-header--sticky{% endif %}">
  <header class="header page-width" role="banner">
    {% comment %} Mobile Menu Drawer {% endcomment %}
    <details id="Details-menu-drawer-container" class="menu-drawer-container">
      <summary class="header__icon header__icon--menu link focus-inset" aria-label="Menu">
        <span class="icon-hamburger">{% render 'icon-hamburger' %}</span>
        <span class="icon-close">{% render 'icon-close' %}</span>
      </summary>
      <div class="menu-drawer__backdrop"></div>
      <div id="menu-drawer" class="menu-drawer" role="dialog" aria-modal="true" aria-label="Navigation Menu">
        <button type="button" class="menu-drawer__close" aria-label="Close menu">
          {% render 'icon-close' %}
        </button>

        <nav class="menu-drawer__nav" role="navigation">
          <ul class="menu-drawer__menu" role="list">
            {%- if nav_menu != blank and nav_menu.size > 3 -%}
              {%- for link in nav_menu -%}
                <li class="menu-drawer__item">
                  {%- if link.links != blank -%}
                    <details class="menu-drawer__details">
                      <summary class="menu-drawer__link">
                        <span>{{ link.title | escape }}</span>
                        {% render 'icon-caret' %}
                      </summary>
                      <ul class="menu-drawer__submenu" role="list">
                        {%- for childlink in link.links -%}
                          <li>
                            <a href="{{ childlink.url }}" class="menu-drawer__sublink">
                              {{ childlink.title | escape }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </details>
                  {%- else -%}
                    <a href="{{ link.url }}" class="menu-drawer__link">
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            {%- else -%}
              <li class="menu-drawer__item"><a href="/" class="menu-drawer__link">HOME</a></li>
              <li class="menu-drawer__item"><a href="/pages/our-story" class="menu-drawer__link">OUR STORY</a></li>
              <li class="menu-drawer__item">
                <details class="menu-drawer__details">
                  <summary class="menu-drawer__link"><span>KITCHEN LINENS</span>{% render 'icon-caret' %}</summary>
                  <ul class="menu-drawer__submenu" role="list">
                    <li><a href="/collections/aprons" class="menu-drawer__sublink">APRONS</a></li>
                    <li><a href="/collections/mittens" class="menu-drawer__sublink">MITTENS</a></li>
                    <li><a href="/collections/kitchen-napkins" class="menu-drawer__sublink">KITCHEN NAPKINS</a></li>
                    <li><a href="/collections/pot-holders" class="menu-drawer__sublink">POT HOLDERS</a></li>
                    <li><a href="/collections/kitechen-gifts" class="menu-drawer__sublink">KITCHEN GIFTS</a></li>
                    <li><a href="/collections/kitechen-combos" class="menu-drawer__sublink">KITCHEN COMBOS</a></li>
                    <li><a href="/collections/kitchen-linens" class="menu-drawer__sublink">ALL</a></li>
                  </ul>
                </details>
              </li>
              <li class="menu-drawer__item">
                <details class="menu-drawer__details">
                  <summary class="menu-drawer__link"><span>TABLE LINENS</span>{% render 'icon-caret' %}</summary>
                  <ul class="menu-drawer__submenu" role="list">
                    <li><a href="/collections/table-runners" class="menu-drawer__sublink">TABLE RUNNERS</a></li>
                    <li><a href="/collections/table-covers" class="menu-drawer__sublink">TABLE COVERS</a></li>
                    <li><a href="/collections/placemats" class="menu-drawer__sublink">PLACEMATS</a></li>
                    <li><a href="/collections/table-gifts" class="menu-drawer__sublink">TABLE GIFTS</a></li>
                    <li><a href="/collections/table-combos" class="menu-drawer__sublink">TABLE COMBOS</a></li>
                    <li><a href="/collections/table-linens" class="menu-drawer__sublink">ALL</a></li>
                  </ul>
                </details>
              </li>
              <li class="menu-drawer__item">
                <details class="menu-drawer__details">
                  <summary class="menu-drawer__link"><span>BED LINENS</span>{% render 'icon-caret' %}</summary>
                  <ul class="menu-drawer__submenu" role="list">
                    <li><a href="/collections/king-flat-sheets" class="menu-drawer__sublink">KING FLAT SHEETS</a></li>
                    <li><a href="/collections/queen-flat-sheets" class="menu-drawer__sublink">QUEEN FLAT SHEETS</a></li>
                    <li><a href="/collections/king-fitted-sheets" class="menu-drawer__sublink">KING FITTED SHEETS</a></li>
                    <li><a href="/collections/bed-linens" class="menu-drawer__sublink">ALL</a></li>
                  </ul>
                </details>
              </li>
              <li class="menu-drawer__item">
                <details class="menu-drawer__details">
                  <summary class="menu-drawer__link"><span>LIVING SPACES</span>{% render 'icon-caret' %}</summary>
                  <ul class="menu-drawer__submenu" role="list">
                    <li><a href="/collections/throw" class="menu-drawer__sublink">THROWS</a></li>
                    <li><a href="/collections/beach-towels" class="menu-drawer__sublink">BEACH TOWELS</a></li>
                    <li><a href="/collections/cushion-covers" class="menu-drawer__sublink">CUSHION COVERS</a></li>
                    <li><a href="/collections/living-space" class="menu-drawer__sublink">ALL</a></li>
                  </ul>
                </details>
              </li>
              <li class="menu-drawer__item">
                <details class="menu-drawer__details">
                  <summary class="menu-drawer__link"><span>GIFTS</span>{% render 'icon-caret' %}</summary>
                  <ul class="menu-drawer__submenu" role="list">
                    <li><a href="/collections/gift-cards" class="menu-drawer__sublink">GIFT CARDS</a></li>
                    <li><a href="/collections/gift-collections" class="menu-drawer__sublink">GIFT COLLECTIONS</a></li>
                    <li><a href="/collections/spring-sales" class="menu-drawer__sublink">SPRING SALES</a></li>
                    <li><a href="/collections" class="menu-drawer__sublink">SHOP ALL</a></li>
                  </ul>
                </details>
              </li>
              <li class="menu-drawer__item"><a href="/bundle" class="menu-drawer__link">BUILD YOUR BUNDLE</a></li>
              <li class="menu-drawer__item"><a href="/blogs/news" class="menu-drawer__link">BLOGS</a></li>
            {%- endif -%}
          </ul>
        </nav>
      </div>
    </details>

    {% comment %} Logo Heading {% endcomment %}
    <div class="header__heading">
      <a href="{{ routes.root_url }}" class="header__heading-link">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: section.settings.logo_width
            | image_tag: class: 'header__heading-logo', alt: shop.name, loading: 'eager'
          }}
        {%- else -%}
          <img
            src="{{ 'oak-and-lily-logo.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="{{ section.settings.logo_width }}"
            height="52"
            class="header__heading-logo"
            loading="eager"
          >
        {%- endif -%}
      </a>
    </div>

    {% comment %} Desktop Inline Navigation {% endcomment %}
    <nav class="header__inline-menu" role="navigation">
      <ul class="list-menu list-menu--inline" role="list">
        {%- if nav_menu != blank and nav_menu.size > 3 -%}
          {%- for link in nav_menu -%}
            <li>
              {%- if link.links != blank -%}
                <details id="Details-HeaderMenu-{{ forloop.index }}" class="header__menu-details">
                  <summary class="header__menu-item link focus-inset">
                    <span>{{ link.title | escape }}</span>
                    {% render 'icon-caret' %}
                  </summary>
                  <ul id="HeaderMenu-MenuList-{{ forloop.index }}" class="header__submenu" role="list">
                    {%- for childlink in link.links -%}
                      <li>
                        <a
                          href="{{ childlink.url }}"
                          class="{% if childlink.current %}is-active{% endif %}"
                        >
                          {{ childlink.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a
                  href="{{ link.url }}"
                  class="header__menu-item link focus-inset{% if link.current %} is-active{% endif %}"
                >
                  <span>{{ link.title | escape }}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="/" class="header__menu-item link focus-inset{% if request.path == '/' %} is-active{% endif %}"><span>HOME</span></a></li>
          <li><a href="/pages/our-story" class="header__menu-item link focus-inset{% if request.path contains '/our-story' %} is-active{% endif %}"><span>OUR STORY</span></a></li>
          <li>
            <details id="Details-HeaderMenu-3" class="header__menu-details">
              <summary class="header__menu-item link focus-inset{% if request.path contains '/kitchen' or request.path contains '/aprons' or request.path contains '/mittens' or request.path contains '/pot-holders' or request.path contains '/kitechen' %} is-active{% endif %}"><span>KITCHEN LINENS</span>{% render 'icon-caret' %}</summary>
              <ul id="HeaderMenu-MenuList-3" class="header__submenu" role="list">
                <li><a href="/collections/aprons">APRONS</a></li>
                <li><a href="/collections/mittens">MITTENS</a></li>
                <li><a href="/collections/kitchen-napkins">KITCHEN NAPKINS</a></li>
                <li><a href="/collections/pot-holders">POT HOLDERS</a></li>
                <li><a href="/collections/kitechen-gifts">KITCHEN GIFTS</a></li>
                <li><a href="/collections/kitechen-combos">KITCHEN COMBOS</a></li>
                <li><a href="/collections/kitchen-linens">ALL</a></li>
              </ul>
            </details>
          </li>
          <li>
            <details id="Details-HeaderMenu-4" class="header__menu-details">
              <summary class="header__menu-item link focus-inset"><span>TABLE LINENS</span>{% render 'icon-caret' %}</summary>
              <ul id="HeaderMenu-MenuList-4" class="header__submenu" role="list">
                <li><a href="/collections/table-runners">TABLE RUNNERS</a></li>
                <li><a href="/collections/table-covers">TABLE COVERS</a></li>
                <li><a href="/collections/placemats">PLACEMATS</a></li>
                <li><a href="/collections/table-gifts">TABLE GIFTS</a></li>
                <li><a href="/collections/table-combos">TABLE COMBOS</a></li>
                <li><a href="/collections/table-linens">ALL</a></li>
              </ul>
            </details>
          </li>
          <li>
            <details id="Details-HeaderMenu-5" class="header__menu-details">
              <summary class="header__menu-item link focus-inset"><span>BED LINENS</span>{% render 'icon-caret' %}</summary>
              <ul id="HeaderMenu-MenuList-5" class="header__submenu" role="list">
                <li><a href="/collections/king-flat-sheets">KING FLAT SHEETS</a></li>
                <li><a href="/collections/queen-flat-sheets">QUEEN FLAT SHEETS</a></li>
                <li><a href="/collections/king-fitted-sheets">KING FITTED SHEETS</a></li>
                <li><a href="/collections/bed-linens">ALL</a></li>
              </ul>
            </details>
          </li>
          <li>
            <details id="Details-HeaderMenu-6" class="header__menu-details">
              <summary class="header__menu-item link focus-inset"><span>LIVING SPACES</span>{% render 'icon-caret' %}</summary>
              <ul id="HeaderMenu-MenuList-6" class="header__submenu" role="list">
                <li><a href="/collections/throw">THROWS</a></li>
                <li><a href="/collections/beach-towels">BEACH TOWELS</a></li>
                <li><a href="/collections/cushion-covers">CUSHION COVERS</a></li>
                <li><a href="/collections/living-space">ALL</a></li>
              </ul>
            </details>
          </li>
          <li>
            <details id="Details-HeaderMenu-7" class="header__menu-details">
              <summary class="header__menu-item link focus-inset"><span>GIFTS</span>{% render 'icon-caret' %}</summary>
              <ul id="HeaderMenu-MenuList-7" class="header__submenu" role="list">
                <li><a href="/collections/gift-cards">GIFT CARDS</a></li>
                <li><a href="/collections/gift-collections">GIFT COLLECTIONS</a></li>
                <li><a href="/collections/spring-sales">SPRING SALES</a></li>
                <li><a href="/collections">SHOP ALL</a></li>
              </ul>
            </details>
          </li>
          <li><a href="/bundle" class="header__menu-item link focus-inset"><span>BUILD YOUR BUNDLE</span></a></li>
          <li><a href="/blogs/news" class="header__menu-item link focus-inset"><span>BLOGS</span></a></li>
        {%- endif -%}
      </ul>
    </nav>

    {% comment %} Header Icons {% endcomment %}
    <div class="header__icons">
      <a href="{{ routes.search_url }}" class="header__icon header__icon--search link focus-inset" aria-label="Search">
        {% render 'icon-search' %}
      </a>

      <a
        href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
        class="header__icon header__icon--account link focus-inset"
        aria-label="Account"
      >
        {% render 'icon-account' %}
      </a>

      <a
        href="{{ routes.cart_url }}"
        class="header__icon header__icon--cart link focus-inset"
        id="cart-icon-bubble"
        aria-label="Cart"
      >
        {% render 'icon-cart' %}
        {%- if cart.item_count > 0 -%}
          <span class="cart-count-bubble">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </header>
</div>

<script>
  (function() {
    var p = window.location.pathname.toLowerCase();
    var kitchenKeys = ['/kitchen', '/aprons', '/mittens', '/pot-holders', '/kitechen'];
    var isKitchen = kitchenKeys.some(function(k) { return p.indexOf(k) !== -1; });
    if (isKitchen) {
      var homeLink = document.querySelector('.header__inline-menu a[href="/"]');
      if (homeLink) homeLink.classList.remove('is-active');
      var kitchenSummary = document.querySelector('#Details-HeaderMenu-3 summary');
      if (kitchenSummary) kitchenSummary.classList.add('is-active');
    }
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 5,
      "unit": "px",
      "label": "Custom logo width",
      "default": 140
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f4ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#103f5a"
    }
  ]
}
{% endschema %}
