{{ 'section-announcement-bar.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --announcement-bg: {{ section.settings.background_color }};
    --announcement-color: {{ section.settings.text_color }};
  }
{%- endstyle -%}

<div class="announcement-bar-wrapper full-width" role="region" aria-label="Announcement bar">
  <div class="announcement-bar">
    {%- if section.blocks.size > 1 -%}
      <button
        type="button"
        class="announcement-bar__btn announcement-bar__btn--prev"
        aria-label="Previous announcement"
        data-action="prev"
      >
        {% render 'icon-caret' %}
      </button>
    {%- endif -%}

    <div
      class="announcement-bar__slider"
      data-auto-rotate="{{ section.settings.auto_rotate }}"
      data-speed="{{ section.settings.change_slides_speed | times: 1000 }}"
    >
      {%- for block in section.blocks -%}
        <div
          class="announcement-bar__slide{% if forloop.first %} is-active{% endif %}"
          data-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="announcement-bar__link">
              <p class="announcement-bar__message">{{ block.settings.text | escape }}</p>
            </a>
          {%- else -%}
            <p class="announcement-bar__message">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <button
        type="button"
        class="announcement-bar__btn announcement-bar__btn--next"
        aria-label="Next announcement"
        data-action="next"
      >
        {% render 'icon-caret' %}
      </button>
    {%- endif -%}
  </div>
</div>

{%- if section.blocks.size > 1 -%}
  <script>
    (function () {
      const section = document.getElementById('shopify-section-{{ section.id }}');
      if (!section) return;
      const slider = section.querySelector('.announcement-bar__slider');
      if (!slider) return;
      const slides = section.querySelectorAll('.announcement-bar__slide');
      if (slides.length <= 1) return;

      let currentIndex = 0;
      let intervalId = null;
      const autoRotate = slider.dataset.autoRotate === 'true';
      const speed = parseInt(slider.dataset.speed, 10) || 4000;

      function showSlide(index) {
        slides[currentIndex].classList.remove('is-active');
        currentIndex = (index + slides.length) % slides.length;
        slides[currentIndex].classList.add('is-active');
      }

      function nextSlide() {
        showSlide(currentIndex + 1);
      }

      function prevSlide() {
        showSlide(currentIndex - 1);
      }

      const prevBtn = section.querySelector('[data-action="prev"]');
      const nextBtn = section.querySelector('[data-action="next"]');

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          prevSlide();
          resetTimer();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          nextSlide();
          resetTimer();
        });
      }

      function startTimer() {
        if (autoRotate && !intervalId) {
          intervalId = setInterval(nextSlide, speed);
        }
      }

      function stopTimer() {
        if (intervalId) {
          clearInterval(intervalId);
          intervalId = null;
        }
      }

      function resetTimer() {
        stopTimer();
        startTimer();
      }

      slider.addEventListener('mouseenter', stopTimer);
      slider.addEventListener('mouseleave', startTimer);
      startTimer();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#9dada2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate announcements",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Enjoy Free shipping and Free Returns!"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Enjoy Free shipping and Free Returns!"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Next Day Delivery for All Bangalore Based Orders"
          }
        }
      ]
    }
  ]
}
{% endschema %}
